{
  "name": "cordon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SIH26171 — privacy-preserving on-device vision agent for the browser",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "demo": "node demo-pages/serve.mjs",
    "eval": "esbuild eval/smoke.ts --bundle --platform=node --format=esm --alias:@=./extension/src --outfile=dist/smoke.mjs --log-level=error && node dist/smoke.mjs",
    "model-check": "node eval/model-check.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "vlm-check": "node eval/vlm-check.mjs",
    "browser-check": "node eval/browser-check.mjs",
    "live-model": "node eval/live-model-check.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.0",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.29.0"
  }
}
