{
  "manifest_version": 3,
  "name": "Cordon \u2014 privacy-preserving browser agent",
  "version": "0.1.0",
  "description": "On-device visual perception with local PII redaction before any network request. SIH26171.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cordon@sih26171",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Cordon"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Cordon"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}